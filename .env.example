# Required: DeepSeek API key. Used by the builder chat AND injected into every
# deployed agent container so it can answer.
DEEPSEEK_API_KEY=

# Optional: default web-search provider key (Tavily). The deploy form can also
# supply this per-deploy. Without it, the web_search tool returns a "not
# configured" notice instead of failing.
TAVILY_API_KEY=
SEARCH_API_KEY=

# Optional: ElevenLabs API key for voice agents (mic + spoken replies).
# Auto-enabled when you build a voice/call agent — get a key at https://elevenlabs.io.
# The deploy form can also supply it per-deploy.
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice ID from YOUR account (required on free plan — library presets won't work).
# Find it at https://elevenlabs.io/app/voice-lab
# ELEVENLABS_VOICE_ID=

# Optional: one-click Railway cloud deploy. With both set, the deploy route
# deploys to Railway on the user's behalf (no token from the end user).
# RAILWAY_TOKEN  = a Railway PROJECT token (Project → Settings → Tokens)
# RAILWAY_SERVICE = the service name within that project to deploy into
RAILWAY_TOKEN=
RAILWAY_SERVICE=
